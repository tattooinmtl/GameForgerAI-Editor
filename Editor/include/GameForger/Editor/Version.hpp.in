#pragma once

// Generated by CMake's configure_file() from CMakeLists.txt's
// project(... VERSION x.y.z) - single source of truth, don't edit the
// generated Version.hpp directly (it lives under the build directory and
// gets overwritten every configure).
namespace gameforger::editor
{
	constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
	constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
	constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;
	// "Alpha" while major version is 0, "Beta" from 1.0.0 onward - matches
	// this project's own versioning convention (README.md's Version
	// History: bump the patch number each meaningful change, Alpha until
	// the build is ready for other people to try, then Beta 1.0.0).
	constexpr const char* kVersionStage = (@PROJECT_VERSION_MAJOR@ == 0) ? "Alpha" : "Beta";
}
